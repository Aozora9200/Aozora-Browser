<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

    <ImageButton
        android:id="@+id/theme_example_image"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:layout_margin="20dp"
        android:src="@drawable/aozora_default"
        android:scaleType="centerInside"
        android:backgroundTint="#00000000"
        />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_margin="20dp"
                android:orientation="vertical">

    <Spinner
        android:id="@+id/setup_styleList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp" />

    <!-- 下部のアクションバー風ボトムバー -->
    <LinearLayout
        android:id="@+id/bottomBarSample"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#000000"
        android:alpha="1.0"
        android:gravity="center">
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nav_button_background"
            android:src="@drawable/ic_sysbar_back" />
        <ImageButton
            android:id="@+id/forwardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nav_button_background"
            android:src="@drawable/ic_sysbar_forward" />
        <!-- 再読み込みボタン -->
        <ImageButton
            android:id="@+id/action_reload"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/reload"
            android:background="@drawable/nav_button_background"
            android:contentDescription="再読込" />
        <!--<ImageButton
        android:id="@+id/action_tab"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:src="@drawable/tab_white"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="タブ" />-->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nav_button_background">
            <TextView
                android:id="@+id/tabCountTextView"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:background="@drawable/rounded_outline"
                android:gravity="center"
                android:text="0"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:layout_marginStart="4dp"/>
        </FrameLayout>
        <ImageButton
            android:id="@+id/action_popup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@mipmap/aozora"
            android:background="@drawable/nav_button_background"
            android:contentDescription="スタート" />
        <ImageButton
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:id="@+id/hidebottom"
            android:background="@drawable/nav_button_background"
            android:src="@drawable/hidebottom" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:text="メニューボタン"
        android:textSize="15sp"/>

    <Spinner
        android:id="@+id/popupbutton_stylelist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:text="矢印ボタン"
        android:textSize="15sp"/>

    <Spinner
        android:id="@+id/arrowbutton_stylelist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

        </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>