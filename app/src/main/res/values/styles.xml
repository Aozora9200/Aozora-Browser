<resources>
    <dimen name="btn_digit_text_size">40sp</dimen>
    <dimen name="btn_operation_text_size">40sp</dimen>
    <dimen name="btn_function_text_size">30sp</dimen>
    <dimen name="btn_clear_text_size">30sp</dimen>
    <dimen name="display_text_size">30sp</dimen>
    <style name="button_style">
        <item name="android:textSize">40dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/btn_function</item>
        <item name="android:layout_marginLeft">1dp</item>
    </style>
    <style name="digit_button_style" parent="button_style">
        <item name="android:background">@drawable/btn_digit</item>
    </style>
    <style name="button_small_style" parent="button_style">
        <item name="android:textSize">30dp</item>
    </style>
    <style name="display_style">
        <item name="android:textSize">@dimen/display_text_size</item>
        <item name="android:inputType">text|textNoSuggestions</item>
        <item name="android:gravity">right|center_vertical</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:maxLines">1</item>
        <item name="android:scrollbars">none</item>
        <item name="android:scrollHorizontally">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
    <style name="btn_row_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dip</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="btn_function_cell_style">
        <item name="android:layout_width">0dip</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/btn_function</item>
        <item name="android:textSize">@dimen/btn_function_text_size</item>
    </style>
    <style name="btn_operation_cell_style">
        <item name="android:layout_width">0dip</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/btn_function</item>
        <item name="android:textSize">@dimen/btn_operation_text_size</item>
    </style>
    <style name="btn_digit_cell_style">
        <item name="android:layout_width">0dip</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/btn_digit</item>
        <item name="android:textSize">@dimen/btn_digit_text_size</item>
    </style>
    <style name="btn_clear">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textSize">@dimen/btn_clear_text_size</item>
    </style>
    <dimen name="left_right_padding">16sp</dimen>
    <dimen name="top_bottom_padding">16sp</dimen>
    <dimen name="group_padding">16sp</dimen>
    <style name="BatteryCapacity.Holo" parent="android:Theme.Holo.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/header_start</item>
        <item name="android:colorPrimaryDark">@color/header_start</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:actionBarStyle">@style/AppActionBar</item>
    </style>
    <style name="BatteryCapacity.Holo.NoActionBar" parent="android:Theme.Holo.Light.NoActionBar">
        <item name="android:colorPrimary">@color/header_start</item>
        <item name="android:colorPrimaryDark">@color/header_start</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="AppActionBar" parent="android:Widget.Holo.Light.ActionBar.Solid.Inverse">
        <item name="android:background">@color/header_start</item>
    </style>
    <!--  ===== 写真の上に直接置く文字 =====  -->
    <style name="Aozora.Text.Title">
        <item name="android:textColor">@color/setup_on_scrim</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Aozora">
        <item name="android:textColor">@color/setup_on_scrim_variant</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Aozora.Text">
        <item name="android:textColor">@color/setup_on_scrim_variant</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Aozora.Text.Body">
        <item name="android:textColor">@color/setup_on_scrim_variant</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Aozora.Text.Caption">
        <item name="android:textColor">@color/setup_on_scrim_variant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <!--  ===== カード（androidx.cardview） =====  -->
    <style name="Aozora.Card">
        <item name="cardBackgroundColor">@color/setup_card</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardMaxElevation">0dp</item>
    </style>
    <!--  カードの中に入れる、ひとつ明るいトーンの入れ子カード（プレビュー・スピナー用）  -->
    <style name="Aozora.Card.Inner">
        <item name="cardBackgroundColor">@color/setup_card_highest</item>
        <item name="cardCornerRadius">20dp</item>
    </style>
    <!--  ===== ボタン（Holo の Button を土台に、背景と文字色だけ差し替え） =====  -->
    <style name="Aozora.Button" parent="android:Widget.Holo.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
    </style>
    <style name="Aozora.Button.Filled">
        <item name="android:background">@drawable/bg_btn_filled</item>
        <item name="android:textColor">@color/setup_on_primary</item>
    </style>
    <style name="Aozora.Button.Tonal">
        <item name="android:background">@drawable/bg_btn_tonal</item>
        <item name="android:textColor">@color/setup_on_secondary_container</item>
    </style>
    <style name="Aozora.Button.Text">
        <item name="android:background">@drawable/bg_btn_text</item>
        <item name="android:textColor">@color/setup_primary</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:gravity">center_vertical|left</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
    <!--  ===== CheckBox をスイッチの見た目にする（型は CheckBox のままなのでコード変更不要） =====  -->
    <style name="Aozora.Switch" parent="android:Widget.Holo.CompoundButton.CheckBox">
        <item name="android:button">@null</item>
        <item name="android:drawableRight">@drawable/switch_selector</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:background">@drawable/bg_pressable</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:textColor">@color/setup_on_card</item>
        <item name="android:textSize">16sp</item>
    </style>
    <!--  ===== 丸みのある進捗バー =====  -->
    <style name="Aozora.Progress" parent="android:Widget.Holo.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_pill</item>
        <item name="android:minHeight">8dp</item>
        <item name="android:maxHeight">8dp</item>
    </style>
</resources>