    <!-- Help: Saved Page -->
    <string name="help_savedpage_title">ページを保存する</string>
    <string name="help_savedpage_detail">ページを保存することで、オフラインでも閲覧することができます。URLバーの横の星ボタンをタップすると、ページを保存できます。ファイルとして保存するには、ツール一覧にあるページ保存ツールを使います。</string>

    <!-- Help: Bookmark -->
    <string name="help_bookmark_title">ブックマークを追加する</string>
    <string name="help_bookmark_detail">ブックマークを追加するには、URLバーの横にある星ボタンから保存できます。</string>

    <!-- Help: Tools -->
    <string name="help_tools_title">ツールを使用する</string>
    <string name="help_tools_detail">ツールを起動するには、メニューボタン(A)を開き、ツール項目をタップします。</string>

    <!-- Help: Switch Tab -->
    <string name="help_switchtab_title">タブを切り替える</string>
    <string name="help_switchtab_detail">タブを切り替えるには、タブボタンをタップし、切り替えるタブを選択します。タブ一覧のメニューボタンから、すべてのタブを閉じることができます。</string>

    <!-- Boot Screen -->
    <string name="help_boot_title">起動画面や起動音を消す</string>
    <string name="help_boot_detail">起動画面や起動音を消すには、\nブラウザ設定の「アプリ設定の項目」から「起動画面」「起動音」のチェックを外すことで消すことができます。</string>

    <!-- Settings -->
    <string name="help_settings_title">設定を開く</string>
    <string name="help_settings_detail">メニューボタン(A)を押し、「設定」を押します。\nブラウザ設定から、各種設定が行えます。</string>

    <!-- UA -->
    <string name="help_ua_title">UAとは</string>
    <string name="help_ua_detail">UA (ユーザーエージェント)とは、Webサイトにアクセスした際に、相手のサイトに渡される自身の端末の情報の事です。</string>

    <!-- Contact Waiting -->
    <string name="help_contact_wait">お待ち下さい...</string>


