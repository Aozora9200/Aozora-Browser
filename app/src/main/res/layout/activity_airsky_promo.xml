<?xml version="1.0" encoding="utf-8"?>
<!-- AirSky Browser のお知らせ・引っ越し画面。背景画像の上に Pixel 風の下部シートを重ね、中身を手順ごとに切り替える -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/airskyBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/airsky_scrim" />

    <TextView
        android:id="@+id/airskyBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="56dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:text="AirSky Browser"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/airskySheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:background="@drawable/airsky_sheet"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/airskyChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/airsky_chip"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textColor="@color/airsky_on_chip"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/airskyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/airsky_on_sheet"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/airskyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/airsky_on_sheet_variant"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/airskyWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/airsky_warning"
                android:lineSpacingExtra="2dp"
                android:padding="16dp"
                android:textColor="@color/airsky_on_warning"
                android:textSize="14sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/airskyProgress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="24dp"
                android:max="100"
                android:progressDrawable="@drawable/airsky_progress"
                android:visibility="gone" />

            <TextView
                android:id="@+id/airskyProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/airsky_on_sheet_variant"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/airskySecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/airsky_button_text"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textColor="@color/airsky_primary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/airskyPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/airsky_button_filled"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textColor="@color/airsky_on_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
