<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="32dp">

            <TextView
                style="@style/Aozora.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="自分好みに設定しましょう" />

            <TextView
                style="@style/Aozora.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="※あとからでも変更できます。" />

            <!-- カード1：背景 -->
            <androidx.cardview.widget.CardView
                style="@style/Aozora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <androidx.cardview.widget.CardView
                        style="@style/Aozora.Card.Inner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageButton
                            android:id="@+id/background_example_image"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:background="@drawable/bg_pressable"
                            android:contentDescription="背景のプレビュー"
                            android:scaleType="centerCrop"
                            android:src="@drawable/setupback" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        style="@style/Aozora.Card.Inner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp">

                            <Spinner
                                android:id="@+id/setup_backgroundList"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:paddingLeft="16dp"
                                android:paddingRight="48dp"
                                android:popupBackground="@drawable/bg_spinner_popup" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center_vertical|right"
                                android:layout_marginRight="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_arrow_drop_down" />
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- カード2：動作の切り替え -->
            <androidx.cardview.widget.CardView
                style="@style/Aozora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp"
                    android:paddingTop="8dp">

                    <CheckBox
                        android:id="@+id/setup_checkbox_desktop"
                        style="@style/Aozora.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="デスクトップモードを有効化する" />

                    <CheckBox
                        android:id="@+id/setup_checkbox_ua"
                        style="@style/Aozora.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ガラケーのユーザーエージェントを有効化する" />

                    <CheckBox
                        android:id="@+id/setup_checkbox_bottom"
                        style="@style/Aozora.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="下部メニューバーを自動的に隠す" />

                    <CheckBox
                        android:id="@+id/setup_checkbox_swipe"
                        style="@style/Aozora.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="スワイプで再読み込み※" />

                    <Button
                        android:id="@+id/setup_help_ua"
                        style="@style/Aozora.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:drawableLeft="@drawable/ic_help_primary"
                        android:text="ユーザーエージェント(UA)とは何ですか?" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                style="@style/Aozora.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="※スワイプで再読み込みは、サイトの仕様によってはスクロールができなくなることがあります。" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
