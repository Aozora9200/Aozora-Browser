<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/framebackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/setupback"
        android:scaleType="centerCrop"/>

    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"/>

    <LinearLayout
        android:id="@+id/statusbar"
        android:layout_width="match_parent"
        android:layout_gravity="top|center"
        android:layout_height="25dp">
        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="textEnd"
            android:textSize="16dp" />
        <TextClock
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:textAlignment="textStart" />
        <TextView
            android:id="@+id/sitename"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="25dp"
            android:text="PIN設定 - Aozora"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAlignment="center"
            android:textSize="16dp" />
        <TextView
            android:layout_width="5dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="textEnd"
            android:textSize="16dp" />
        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="textEnd"
            android:textSize="16dp" />
        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="textEnd"
            android:textSize="16dp" />
        <TextView
            android:layout_width="55dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="textEnd"
            android:textSize="16dp" />
        <TextView
            android:layout_width="10dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="textEnd"
            android:textSize="16dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="32dp"
        android:gravity="center">

        <TextView
            android:id="@+id/setpassword_msg"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="20sp"
            android:layout_gravity="center|top"
            android:layout_marginTop="40dp"/>

        <LinearLayout
            android:id="@+id/new_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:layout_marginTop="150dp"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:padding="24dp">


                <!-- PIN入力 -->
                <LinearLayout
                    android:id="@+id/pinLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="visible">

                    <!-- PIN表示 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/pinDisplay"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginStart="50dp"
                            android:gravity="center"
                            android:orientation="horizontal"/>

                        <TextView
                            android:id="@+id/pinBackspace"
                            android:layout_width="50dp"
                            android:layout_height="38dp"
                            android:gravity="center"
                            android:text="⌫"
                            android:background="@drawable/nav_button_background"
                            android:textSize="28sp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>


                    <!-- 1 2 3 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/pin1"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:text="1"
                            android:textSize="25sp"
                            android:background="@drawable/nav_button_background"/>

                        <Button
                            android:id="@+id/pin2"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:text="2"
                            android:textSize="25sp"
                            android:background="@drawable/nav_button_background"/>

                        <Button
                            android:id="@+id/pin3"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:text="3"
                            android:textSize="25sp"
                            android:background="@drawable/nav_button_background"/>
                    </LinearLayout>


                    <!-- 4 5 6 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/pin4"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:text="4"
                            android:textSize="25sp"
                            android:background="@drawable/nav_button_background"/>

                        <Button
                            android:id="@+id/pin5"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:text="5"
                            android:textSize="25sp"
                            android:background="@drawable/nav_button_background"/>

                        <Button
                            android:id="@+id/pin6"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:text="6"
                            android:textSize="25sp"
                            android:background="@drawable/nav_button_background"/>
                    </LinearLayout>


                    <!-- 7 8 9 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/pin7"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:text="7"
                            android:textSize="25sp"
                            android:background="@drawable/nav_button_background"/>

                        <Button
                            android:id="@+id/pin8"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:text="8"
                            android:textSize="25sp"
                            android:background="@drawable/nav_button_background"/>

                        <Button
                            android:id="@+id/pin9"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:text="9"
                            android:textSize="25sp"
                            android:background="@drawable/nav_button_background"/>
                    </LinearLayout>


                    <!-- 空白 0 ✓ -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Space
                            android:layout_width="76dp"
                            android:layout_height="76dp"/>

                        <Button
                            android:id="@+id/pin0"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:text="0"
                            android:textSize="25sp"
                            android:background="@drawable/nav_button_background"/>

                        <ImageButton
                            android:id="@+id/pinEnter"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:src="@drawable/ios_forward"
                            android:textSize="30sp"
                            android:background="@drawable/nav_button_background"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</FrameLayout>