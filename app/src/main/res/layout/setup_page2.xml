<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="32dp">

            <TextView
                style="@style/Aozora.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="テーマを選びましょう" />

            <TextView
                style="@style/Aozora.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="※あとからでも変更できます。" />

            <androidx.cardview.widget.CardView
                style="@style/Aozora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- テーマのプレビュー -->
                    <androidx.cardview.widget.CardView
                        style="@style/Aozora.Card.Inner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageButton
                            android:id="@+id/theme_example_image"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:background="@drawable/bg_pressable"
                            android:contentDescription="テーマのプレビュー"
                            android:maxHeight="240dp"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/aozora_default" />
                    </androidx.cardview.widget.CardView>

                    <!-- テーマ選択（Spinner はそのまま、見た目だけフィールド風に） -->
                    <androidx.cardview.widget.CardView
                        style="@style/Aozora.Card.Inner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp">

                            <Spinner
                                android:id="@+id/setup_styleList"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:paddingLeft="16dp"
                                android:paddingRight="48dp"
                                android:popupBackground="@drawable/bg_spinner_popup" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center_vertical|right"
                                android:layout_marginRight="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_arrow_drop_down" />
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>

                    <CheckBox
                        android:id="@+id/setup_checkbox_progressBar"
                        style="@style/Aozora.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="プログレスバー進行時のアニメーションを有効化する" />

                    <Button
                        android:id="@+id/setup_help_progress"
                        style="@style/Aozora.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/ic_help_primary"
                        android:text="プログレスバーとは何ですか?" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
