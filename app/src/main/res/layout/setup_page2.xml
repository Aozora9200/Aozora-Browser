<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="テーマを選びましょう"
        android:paddingTop="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:textColor="#BBBBBB"
        android:textSize="30sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="※あとからでも変更できます。"
        android:paddingTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:textColor="#BBBBBB"
        android:textSize="15sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <ImageButton
        android:id="@+id/theme_example_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="180dp"
        android:src="@drawable/aozora_default"
        android:scaleType="centerInside"
        android:backgroundTint="#00000000"
        />

    <Spinner
        android:id="@+id/setup_styleList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="140dp"
        android:layout_gravity="bottom"
        android:layout_marginTop="20dp" />

    <CheckBox android:id="@+id/setup_checkbox_progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="90dp"
        android:layout_gravity="bottom"
        android:textColor="#BBBBBB"
        android:text="プログレスバー進行時のアニメーションを有効化する" />
    <Button
        android:id="@+id/setup_help_progress"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="50dp"
        android:layout_gravity="bottom"
        android:backgroundTint="#00000000"
        android:textColor="#BBBBBB"
        android:gravity="start"
        android:text="プログレスバーとは何ですか?"
        />
    </FrameLayout>
</LinearLayout>