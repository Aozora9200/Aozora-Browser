<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/framebackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/setupback"
        android:scaleType="centerCrop"/>

    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"/>

    <LinearLayout
        android:id="@+id/statusbar"
        android:layout_width="match_parent"
        android:layout_gravity="top|center"
        android:layout_height="25dp">
        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="textEnd"
            android:textSize="16dp" />
        <TextClock
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:textAlignment="textStart" />
        <TextView
            android:id="@+id/sitename"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="25dp"
            android:text="パスワード設定 - Aozora"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAlignment="center"
            android:textSize="16dp" />
        <TextView
            android:layout_width="5dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="textEnd"
            android:textSize="16dp" />
        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="textEnd"
            android:textSize="16dp" />
        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="textEnd"
            android:textSize="16dp" />
        <TextView
            android:layout_width="55dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="textEnd"
            android:textSize="16dp" />
        <TextView
            android:layout_width="10dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="textEnd"
            android:textSize="16dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="32dp"
        android:gravity="center">

        <TextView
            android:id="@+id/setpassword_msg"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="パスワードを設定"
            android:textSize="20sp"
            android:layout_gravity="center|top"
            android:layout_marginTop="40dp"/>

        <LinearLayout
            android:id="@+id/none"
            android:background="@drawable/nav_button_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="top"
            android:layout_marginTop="120dp"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/passwordEditText"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:textSize="20sp"
                android:text="なし"
                android:gravity="start|center"
                android:singleLine="true"
                android:layout_gravity="center"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/set_pin"
            android:background="@drawable/nav_button_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="top"
            android:layout_marginTop="200dp"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:textSize="20sp"
                android:text="PIN"
                android:gravity="start|center"
                android:singleLine="true"
                android:layout_gravity="center"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/set_password"
            android:background="@drawable/nav_button_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="top"
            android:layout_marginTop="280dp"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:textSize="20sp"
                android:text="パスワード"
                android:gravity="start|center"
                android:singleLine="true"
                android:layout_gravity="center"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>

        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="center|start"
            android:layout_marginTop="70dp"
            android:id="@+id/usePassword"
            android:text="起動時にパスワードを要求する(推奨)"
            android:visibility="gone"/>

        <CheckBox
            android:id="@+id/passwordSkipCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|start"
            android:layout_marginTop="140dp"
            android:text="認証後の一定時間パスワード要求をスキップする"
            android:visibility="gone"/>

        <Spinner
            android:id="@+id/passwordSkipSpinner"
            android:layout_width="180dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="200dp"
            android:visibility="gone"/>
    </FrameLayout>
</FrameLayout>