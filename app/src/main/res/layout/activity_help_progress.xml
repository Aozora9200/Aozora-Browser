<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/setupback" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:paddingTop="40dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:text="プログレスバーとは"
            android:textColor="#BBBBBB"
            android:textSize="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:paddingTop="100dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:text="プログレスバーとは、ダウンロードやサイトの移動時に、現在の処理状況を視覚的に表示する棒線です。"
            android:textSize="20dp"
            android:textColor="#BBBBBB"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="アニメーション有"
            android:paddingTop="200dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:textColor="#BBBBBB"
            android:textSize="15sp" />

        <VideoView
            android:id="@+id/progress_animation"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="230dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="アニメーション無"
            android:paddingTop="340dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:textColor="#BBBBBB"
            android:textSize="15sp" />

        <VideoView
            android:id="@+id/progress_default"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="370dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>

        <Button
            android:id="@+id/help_close"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="bottom"
            android:textColor="#BBBBBB"
            android:text="閉じる"
            android:backgroundTint="#33000000"
            />

    </FrameLayout>
</LinearLayout>